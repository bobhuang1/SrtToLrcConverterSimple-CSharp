<Window x:Class="SrtToLrcConverterSimple.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRT → LRC Converter"
        Height="740" Width="1040"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source -->
        <GroupBox Grid.Row="0" Header="Source">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="Folder (recursive)" IsChecked="{Binding IsFolderMode, Mode=TwoWay}" Margin="0,0,18,0" />
                    <RadioButton Content="Single file" IsChecked="{Binding IsFileMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                             Width="760" VerticalAlignment="Center" />
                    <Button Content="Browse…" Command="{Binding BrowseInputCommand}"
                            Width="90" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Options -->
        <GroupBox Grid.Row="1" Header="Options" Margin="0,8,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Output encoding" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Encodings}"
                              SelectedItem="{Binding SelectedEncoding}"
                              DisplayMemberPath="Label"
                              Width="190" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <CheckBox Content="Output to a different folder"
                              IsChecked="{Binding OverrideOutputDir, Mode=TwoWay}"
                              Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding OverrideOutputDir}"
                                 Width="250" VerticalAlignment="Center" />
                        <Button Content="…" Command="{Binding BrowseOutputCommand}"
                                IsEnabled="{Binding OverrideOutputDir}"
                                Width="30" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Filename suffixes to strip (one per line)" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SuffixListText, UpdateSourceTrigger=PropertyChanged}"
                             Height="64" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Results + preview -->
        <GroupBox Grid.Row="2" Header="Results" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0" Margin="4"
                          ItemsSource="{Binding Results}"
                          SelectedItem="{Binding SelectedResult, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Input file" Width="320" DisplayMemberBinding="{Binding InputFile}" />
                            <GridViewColumn Header="Output file" Width="320" DisplayMemberBinding="{Binding OutputFile}" />
                            <GridViewColumn Header="Status" Width="70" DisplayMemberBinding="{Binding Status}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Grid.Row="1" Text="LRC preview (select a result)" Margin="6,6,0,2" Foreground="Gray" />

                <TextBox Grid.Row="2" Margin="4"
                         Text="{Binding PreviewText, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         TextWrapping="NoWrap" />
            </Grid>
        </GroupBox>

        <!-- Status + action -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />

            <ProgressBar Grid.Column="1" Width="120" Height="14"
                         IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Center" Margin="4,0" />

            <Button Grid.Column="2" Content="Convert"
                    Command="{Binding ConvertCommand}"
                    Width="120" Height="30" Margin="4,0,0,0" />
        </Grid>
    </Grid>
</Window>