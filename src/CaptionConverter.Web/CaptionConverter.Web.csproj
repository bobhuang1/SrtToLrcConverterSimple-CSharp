<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>CaptionConverter.Web</RootNamespace>
    <!-- CodePagesEncodingProvider needs real globalization data so the ANSI
         fallback can decode legacy single-byte subtitle files (cp1252, GB18030,
         Shift-JIS...) in the browser, where Encoding.Default would be UTF-8. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The demo reuses the shipped conversion core verbatim; only the browser
         file I/O and the download are new. -->
    <ProjectReference Include="../CaptionConverter.Core/CaptionConverter.Core.csproj" />
  </ItemGroup>

</Project>
