@page "/"
@using System.Text
@implements IAsyncDisposable
@inject SubtitleConverter Converter
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>CaptionConverter &mdash; subtitle to LRC in your browser</PageTitle>

<h1>Subtitle to LRC, instantly</h1>
<p class="lede">
    Drop in a subtitle file and get a synchronized <code>.lrc</code> lyric file.
    Eight input formats are detected from content alone, and everything runs in
    this page &mdash; the same <code>CaptionConverter.Core</code> C# that the WPF
    app and the CLI use, compiled to WebAssembly. Nothing is uploaded.
</p>

<section class="panel">
    <h2>1 &mdash; Pick a subtitle file</h2>
    <div class="dropzone">
        <InputFile OnChange="OnFileSelected"
                   accept=".srt,.vtt,.ass,.ssa,.smi,.sub,.mpl2,.pjs,.ttml,.dfxp" />
        <p class="hint">or try a bundled sample:</p>
        <div class="samples">
            <button type="button" class="btn btn-ghost" @onclick="LoadSrtAsync" disabled="@_busy">SubRip (.srt)</button>
            <button type="button" class="btn btn-ghost" @onclick="LoadVttAsync" disabled="@_busy">WebVTT (.vtt)</button>
            <button type="button" class="btn btn-ghost" @onclick="LoadAssAsync" disabled="@_busy">SubStation (.ass)</button>
        </div>
    </div>
</section>

<section class="panel">
    <h2>2 &mdash; Legacy text encoding</h2>
    <p class="hint">
        Input is sniffed as BOM, then strict UTF-8, then this fallback. It only
        matters for old single-byte files; leave it on Auto unless the lyrics come
        out as mojibake.
    </p>
    <select class="select" @bind="_ansiChoice" @bind:after="OnAnsiChanged">
        @for (var i = 0; i < AnsiChoices.Length; i++)
        {
            <option value="@i">@AnsiChoices[i].Label</option>
        }
    </select>
</section>

@if (_busy)
{
    <p class="status">Converting&hellip;</p>
}

@if (_error is not null)
{
    <p class="status status-error">@_error</p>
}

@if (_lrc is not null)
{
    <section class="panel">
        <h2>3 &mdash; Result</h2>
        <div class="badges">
            <span class="badge badge-format">@_format</span>
            <span class="badge">@_cueCount cue(s)</span>
            @if (_warnings.Count > 0)
            {
                <span class="badge badge-warn">@_warnings.Count warning(s)</span>
            }
        </div>

        <pre class="lrc">@_lrc</pre>

        <button type="button" class="btn btn-primary" @onclick="DownloadAsync">
            Download @_suggestedName
        </button>

        @if (_warnings.Count > 0)
        {
            <details class="warnings">
                <summary>Parser warnings</summary>
                <ul>
                    @foreach (var warning in _warnings)
                    {
                        <li><span class="seq">#@warning.Sequence</span> @warning.Message</li>
                    }
                </ul>
            </details>
        }
    </section>
}

@code {
    // Subtitle files are small; this is a generous ceiling that still stops a
    // mistaken multi-gigabyte drop from exhausting browser memory.
    private const long MaxFileBytes = 32L * 1024 * 1024;

    private static readonly (string Label, string? CodePage)[] AnsiChoices =
    [
        ("Auto (BOM, then strict UTF-8)", null),
        ("Windows-1252 - Western European", "windows-1252"),
        ("GB18030 - Simplified Chinese", "gb18030"),
        ("Big5 - Traditional Chinese", "big5"),
        ("Shift-JIS - Japanese", "shift_jis"),
        ("EUC-KR - Korean", "euc-kr"),
    ];

    private readonly LrcConversionOptions _options = new();

    private byte[]? _sourceBytes;
    private string? _sourceName;
    private string? _lrc;
    private string? _suggestedName;
    private IReadOnlyList<SrtWarning> _warnings = Array.Empty<SrtWarning>();
    private SubtitleFormatKind _format;
    private int _ansiChoice;
    private int _cueCount;
    private bool _busy;
    private string? _error;
    private IJSObjectReference? _downloadModule;

    private Encoding? AnsiEncoding
    {
        get
        {
            var codePage = AnsiChoices[_ansiChoice].CodePage;
            if (codePage is null)
            {
                return null;
            }

            try
            {
                return Encoding.GetEncoding(codePage);
            }
            catch (Exception)
            {
                // This runtime has no codepage tables; the converter then falls
                // back to Encoding.Default.
                return null;
            }
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file.Size > MaxFileBytes)
        {
            _error = "That file is larger than 32 MB, which no subtitle file should be.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            Load(file.Name, buffer.ToArray());
        }
        catch (Exception ex)
        {
            _error = "Could not read that file: " + ex.Message;
            _lrc = null;
        }
        finally
        {
            _busy = false;
        }
    }

    // ?sample=demo.srt makes a converted result directly linkable, which is
    // also how the README screenshot is produced.
    private static readonly string[] SampleNames = ["demo.srt", "demo.vtt", "demo.ass"];

    protected override async Task OnInitializedAsync()
    {
        var name = SampleFromUri();
        if (name is not null)
        {
            await LoadSampleAsync(name);
        }
    }

    private string? SampleFromUri()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var query = relative.IndexOf("?");
        if (query < 0)
        {
            return null;
        }

        foreach (var pair in relative[(query + 1)..].Split("&", StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split("=", 2);
            // Only the bundled samples are accepted, so the query string can
            // never be used to fetch an arbitrary path.
            if (kv.Length == 2 && kv[0] == "sample" && SampleNames.Contains(kv[1]))
            {
                return kv[1];
            }
        }

        return null;
    }

    private Task LoadSrtAsync() => LoadSampleAsync("demo.srt");
    private Task LoadVttAsync() => LoadSampleAsync("demo.vtt");
    private Task LoadAssAsync() => LoadSampleAsync("demo.ass");

    private async Task LoadSampleAsync(string name)
    {
        _busy = true;
        _error = null;
        try
        {
            var bytes = await Http.GetByteArrayAsync("samples/" + name);
            Load(name, bytes);
        }
        catch (Exception ex)
        {
            _error = "Could not load the sample: " + ex.Message;
            _lrc = null;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnAnsiChanged()
    {
        if (_sourceBytes is not null && _sourceName is not null)
        {
            Load(_sourceName, _sourceBytes);
        }
    }

    private void Load(string name, byte[] bytes)
    {
        _sourceBytes = bytes;
        _sourceName = name;
        _options.AnsiEncoding = AnsiEncoding;

        var text = bytes.Length == 0
            ? string.Empty
            : SubtitleTextDecoder.Decode(bytes, _options.AnsiEncoding);

        // Parse() detects from content only, so report the same format it used
        // rather than letting the filename influence the badge.
        _format = SubtitleFormat.Detect(string.Empty, text);

        var result = Converter.Parse(text);
        _lrc = result.Text;
        _warnings = result.Warnings;
        _cueCount = result.Text
            .Split((char)10)
            .Count(line => line.StartsWith("[", StringComparison.Ordinal));
        _suggestedName = Path.GetFileName(Converter.GetOutputPath(name, _options));
    }

    private async Task DownloadAsync()
    {
        if (_lrc is null || _suggestedName is null)
        {
            return;
        }

        _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/captionconverter.js");
        await _downloadModule.InvokeVoidAsync("downloadText", _suggestedName, _lrc);
    }

    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is not null)
        {
            await _downloadModule.DisposeAsync();
        }
    }
}

