@page "/"
@implements IAsyncDisposable
@inject SubtitleConverter Converter
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>CaptionConverter &mdash; subtitle to LRC in your browser</PageTitle>

<h1>Subtitle to LRC, instantly</h1>
<p class="lede">
    Drop in a subtitle file and get a synchronized <code>.lrc</code> lyric file.
    Eight input formats are detected from content alone, and everything runs in
    this page &mdash; the same <code>CaptionConverter.Core</code> C# that the WPF
    app and the CLI use, compiled to WebAssembly. Nothing is uploaded.
</p>

<FilePickerPanel Disabled="_busy"
                 OnPickFile="OnFileSelectedAsync"
                 OnPickSample="LoadSampleAsync" />

<EncodingPanel @bind-AnsiChoice="Session.AnsiChoice" />

@if (_busy)
{
    <p class="status">Converting&hellip;</p>
}

@if (_error is not null)
{
    <p class="status status-error">@_error</p>
}

@if (Session.Lrc is not null)
{
    @* The @ matters on the two string parameters: without it Razor passes the
       text "Session.Lrc" as a literal instead of the value. *@
    <ResultPanel Lrc="@Session.Lrc"
                 SuggestedName="@Session.SuggestedName"
                 Warnings="Session.Warnings"
                 Format="Session.Format"
                 CueCount="Session.CueCount"
                 OnDownload="DownloadAsync" />
}

@code {
    // Subtitle files are small; this is a generous ceiling that still stops a
    // mistaken multi-gigabyte drop from exhausting browser memory.
    private const long MaxFileBytes = 32L * 1024 * 1024;

    // The conversion itself lives in SubtitleSession; this page owns only the
    // browser side of it: reading files, fetching samples and downloading.
    private SubtitleSession? _session;
    private SubtitleSession Session => _session ??= new SubtitleSession(Converter);

    private bool _busy;
    private string? _error;
    private IJSObjectReference? _downloadModule;

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file.Size > MaxFileBytes)
        {
            _error = "That file is larger than 32 MB, which no subtitle file should be.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            Session.Load(file.Name, buffer.ToArray());
        }
        catch (Exception ex)
        {
            _error = "Could not read that file: " + ex.Message;
            Session.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadSampleAsync(string name)
    {
        _busy = true;
        _error = null;
        try
        {
            var bytes = await Http.GetByteArrayAsync("samples/" + name);
            Session.Load(name, bytes);
        }
        catch (Exception ex)
        {
            _error = "Could not load the sample: " + ex.Message;
            Session.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    // ?sample=demo.srt makes a converted result directly linkable, which is
    // also how the README screenshot is produced.
    protected override async Task OnInitializedAsync()
    {
        var name = SampleFromUri();
        if (name is not null)
        {
            await LoadSampleAsync(name);
        }
    }

    private string? SampleFromUri()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var query = relative.IndexOf("?");
        if (query < 0)
        {
            return null;
        }

        foreach (var pair in relative[(query + 1)..].Split("&", StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split("=", 2);
            // Only the bundled samples are accepted, so the query string can
            // never be used to fetch an arbitrary path.
            if (kv.Length == 2 && kv[0] == "sample" && DemoSamples.IsBundled(kv[1]))
            {
                return kv[1];
            }
        }

        return null;
    }

    private async Task DownloadAsync()
    {
        if (Session.Lrc is not { } lrc || Session.SuggestedName is not { } suggestedName)
        {
            return;
        }

        _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/captionconverter.js");
        await _downloadModule.InvokeVoidAsync("downloadText", suggestedName, lrc);
    }

    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is not null)
        {
            await _downloadModule.DisposeAsync();
        }
    }
}
