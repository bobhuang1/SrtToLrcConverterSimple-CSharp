<section class="panel">
    <h2>2 &mdash; Legacy text encoding</h2>
    <p class="hint">
        Input is sniffed as BOM, then strict UTF-8, then this fallback. It only
        matters for old single-byte files; leave it on Auto unless the lyrics come
        out as mojibake.
    </p>
    @* Deliberately not @bind: an element binding only writes the value back into
       this component's own property and never raises AnsiChoiceChanged, so the
       page would sit on the old conversion until some other input arrived. *@
    <select class="select" value="@AnsiChoice.ToString()" @onchange="OnSelectionChanged">
        @for (var i = 0; i < AnsiEncodingChoices.All.Length; i++)
        {
            <option value="@i">@AnsiEncodingChoices.All[i].Label</option>
        }
    </select>
</section>

@code {
    [Parameter]
    public int AnsiChoice { get; set; }

    [Parameter]
    public EventCallback<int> AnsiChoiceChanged { get; set; }

    private Task OnSelectionChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value as string, out var index))
        {
            AnsiChoice = index;
        }

        return AnsiChoiceChanged.InvokeAsync(AnsiChoice);
    }
}
